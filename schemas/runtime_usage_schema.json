{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily report runtime usage record",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "trading_date",
    "slot",
    "phase",
    "status",
    "retries",
    "full_fallbacks",
    "details"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string"},
    "trading_date": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"},
    "slot": {"enum": ["morning", "midday", "evening"]},
    "phase": {"type": "string", "minLength": 1},
    "status": {"enum": ["started", "success", "failed", "blocked"]},
    "duration_ms": {"type": ["integer", "null"], "minimum": 0},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "tool_calls": {"type": ["integer", "null"], "minimum": 0},
    "retries": {"type": "integer", "minimum": 0},
    "full_fallbacks": {"type": "integer", "minimum": 0},
    "details": {"type": "object"}
  },
  "additionalProperties": false
}
