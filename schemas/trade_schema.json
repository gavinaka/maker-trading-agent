{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TradeCheckRecord",
  "description": "交易 Check 数据库单条记录（图谱第九节，22 字段）。outputs/<YYYY-MM-DD>_check_records.json 的 items 遵循此 schema",
  "type": "object",
  "required": [
    "plan_start_time",
    "symbol",
    "account",
    "position_size_usd",
    "risk_checklist",
    "plan_quality",
    "emotional_action",
    "executed_by_plan",
    "status",
    "strategy",
    "entry_mode",
    "holding_period",
    "entry_type",
    "leverage",
    "floating_defense_plan"
  ],
  "properties": {
    "plan_start_time": {
      "type": "string",
      "format": "date-time",
      "description": "计划起始时间 ISO 8601"
    },
    "symbol": {
      "type": "string",
      "enum": ["BTCUSDT", "ETHUSDT", "XAUUSDT"]
    },
    "account": {
      "type": "string",
      "enum": ["main", "maker"],
      "description": "Taker 已于 2026.3.8 合并到 main"
    },
    "position_size_usd": {
      "type": "number",
      "minimum": 0,
      "description": "持仓量（美元）。BTC Maker $500-$1000；ETH Maker $300-$800；主账户中线 $2000-$4000"
    },
    "risk_checklist": {
      "type": "object",
      "required": [
        "1_plan_recorded",
        "2_risk_exposure",
        "3_market_confirmation",
        "4_sl_tp_set",
        "5_in_time_window",
        "6_strict_signal",
        "7_single_loss_under_3pct"
      ],
      "properties": {
        "1_plan_recorded":          { "type": "boolean", "description": "是否记录交易计划" },
        "2_risk_exposure":          { "type": "boolean", "description": "是否符合风险敞口要求" },
        "3_market_confirmation":    { "type": "boolean", "description": "是否完成技术面确认" },
        "4_sl_tp_set":              { "type": "boolean", "description": "是否设置好止损止盈" },
        "5_in_time_window":         { "type": "boolean", "description": "是否在规定交易时间内" },
        "6_strict_signal":          { "type": "boolean", "description": "是否严格按入场信号执行" },
        "7_single_loss_under_3pct": { "type": "boolean", "description": "单笔止损是否 ≤ 3%（2026.3.5 起新增）" }
      },
      "description": "图谱第四节风控检核 7 项"
    },
    "plan_quality": {
      "type": "string",
      "enum": ["高", "中", "低"],
      "description": "计划质量评级。高=完整填写+强逻辑+共振信号充分；中=基本达标；低=缺检核项/违规/情绪化（不计入洁净样本）"
    },
    "emotional_action": {
      "type": "boolean",
      "description": "是否情绪化操作（true → penalty_agent 必标违规）"
    },
    "executed_by_plan": {
      "type": "boolean",
      "description": "是否按照计划执行"
    },
    "status": {
      "type": "string",
      "enum": ["已平仓", "未开仓", "持仓中"]
    },
    "strategy": {
      "type": "string",
      "enum": ["做空", "做多"]
    },
    "entry_mode": {
      "type": "string",
      "enum": ["Taker", "Maker"],
      "description": "挂单方式（非账户名）。Maker=限价挂单，Taker=市价吃单"
    },
    "holding_period": {
      "type": "string",
      "enum": ["长持（走计划看盈亏比）", "短线", "实时盯盘"]
    },
    "entry_type": {
      "type": "string",
      "enum": ["左侧", "右侧"]
    },
    "leverage": {
      "type": "number",
      "enum": [3, 5],
      "description": "杠杆。2026.3 起标准 5x；2026.1 时期为 3x（历史数据）"
    },
    "floating_defense_plan": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["layer", "trigger", "action"],
        "properties": {
          "layer": { "type": "integer", "minimum": 1, "maximum": 5 },
          "trigger": { "type": "string", "description": "触发条件，如价格触及 XXXX" },
          "action": { "type": "string", "description": "操作，如止损移至 XXXX / 减仓 X%" }
        }
      },
      "description": "主账户最多 5 层；Maker 2-3 层"
    },
    "notes_open_rationale": {
      "type": "string",
      "description": "开仓理由 / 核心逻辑（备注字段）"
    },
    "description_log": {
      "type": "string",
      "description": "复盘（主账户为跨日演变日志，Maker 为单次事后复盘）"
    },
    "profit": {
      "type": "boolean",
      "description": "是否盈利（status==已平仓 时必填）"
    },
    "rr_ratio": {
      "type": "string",
      "pattern": "^1:[0-9]+(\\.[0-9]+)?$",
      "description": "盈亏比，如 1:2.5 / 1:3"
    },
    "pnl_usd": {
      "type": "number",
      "description": "盈亏金额 USD（status==已平仓 时必填）"
    },
    "pct": {
      "type": "number",
      "description": "账户百分比 ±%"
    },
    "clean_sample_eligible": {
      "type": "boolean",
      "description": "是否计入洁净样本。判定 = account==maker AND executed_by_plan AND NOT emotional_action AND 7 项全 true AND plan_quality in [高,中] AND penalty_agent 未标违规"
    }
  }
}
