{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReviewRecord",
  "description": "复盘记录统一 schema（日/周/月 review_agent 输出）",
  "type": "object",
  "oneOf": [
    { "$ref": "#/definitions/daily_review" },
    { "$ref": "#/definitions/weekly_review" },
    { "$ref": "#/definitions/monthly_review" }
  ],
  "definitions": {
    "daily_review": {
      "type": "object",
      "title": "DailyReview",
      "description": "日复盘（图谱十七节，5 个核心问题）",
      "required": ["type", "date", "weekday", "q1_plan_completion", "q2_trade_cycle", "q3_left_right_shift", "q4_mental_control", "q5_mid_term_status", "summary"],
      "properties": {
        "type": { "const": "daily" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "weekday": { "type": "string", "enum": ["周一", "周二", "周三", "周四", "周五", "周六", "周日"] },
        "q1_plan_completion": {
          "type": "object",
          "properties": {
            "morning_plan_status": { "type": "string", "enum": ["观望", "有计划"] },
            "evening_plan_status": { "type": "string", "enum": ["观望", "有计划", "已新增"] },
            "executed_count": { "type": "integer", "minimum": 0 },
            "planned_count": { "type": "integer", "minimum": 0 },
            "completion_pct": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "q2_trade_cycle": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["已开单", "未开单", "执行了多笔"] },
            "trades": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "symbol": { "type": "string" },
                  "direction": { "type": "string", "enum": ["做空", "做多"] },
                  "entry_price": { "type": "number" },
                  "exit_price": { "type": "number" },
                  "rr_actual": { "type": "string" },
                  "profit": { "type": "boolean" }
                }
              }
            }
          }
        },
        "q3_left_right_shift": {
          "type": "object",
          "properties": {
            "left_count": { "type": "integer", "minimum": 0 },
            "right_count": { "type": "integer", "minimum": 0 },
            "trend_7d": { "type": "string", "enum": ["左→右偏移", "右→左偏移", "持平"] },
            "note": { "type": "string" }
          }
        },
        "q4_mental_control": {
          "type": "object",
          "properties": {
            "work_impact": { "type": "integer", "minimum": 1, "maximum": 5 },
            "life_impact": { "type": "integer", "minimum": 1, "maximum": 5 },
            "emotion_event": { "type": "string" },
            "state_gate_trigger_count": { "type": "integer", "minimum": 0 }
          }
        },
        "q5_mid_term_status": {
          "type": "object",
          "properties": {
            "symbol": { "type": "string" },
            "direction": { "type": "string" },
            "average_entry": { "type": "number" },
            "position_pct": { "type": "number" },
            "floating_pnl_usd": { "type": "number" },
            "current_defense_layer": { "type": "integer", "minimum": 1, "maximum": 5 },
            "iterated_today": { "type": "boolean" },
            "iteration_detail": { "type": "string" }
          }
        },
        "summary": {
          "type": "string",
          "minLength": 10,
          "description": "用户输入。禁止 AI 生成。禁止口号化"
        }
      }
    },
    "weekly_review": {
      "type": "object",
      "title": "WeeklyReview",
      "description": "周报（图谱十九节）",
      "required": ["type", "week_id", "period_start", "period_end", "keyword", "capital_review", "strategy_review", "clean_sample_progress", "summary"],
      "properties": {
        "type": { "const": "weekly" },
        "week_id": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
        "period_start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "period_end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "keyword": {
          "type": "string",
          "description": "图谱十九节关键词体系。2026.3 起默认 '洁净样本打造' 或 '出场标准优化'"
        },
        "capital_review": {
          "type": "object",
          "properties": {
            "principal_usd": { "type": "number", "const": 1200 },
            "current_okx_usd": { "type": "number" },
            "current_binance_usd": { "type": "number" },
            "total_current_usd": { "type": "number" },
            "wow_pct": { "type": "number" },
            "summary": { "type": "string" }
          }
        },
        "strategy_review": {
          "type": "object",
          "properties": {
            "maker": {
              "type": "object",
              "properties": {
                "trade_count": { "type": "integer" },
                "win_rate_pct": { "type": "number" },
                "cumulative_pnl_usd": { "type": "number" },
                "cumulative_pct": { "type": "number" },
                "clean_sample_contribution": { "type": "integer" },
                "summary": { "type": "string" }
              }
            },
            "main_account": {
              "type": "object",
              "properties": {
                "position_symbol": { "type": "string" },
                "direction": { "type": "string" },
                "average_entry": { "type": "number" },
                "position_pct": { "type": "number" },
                "floating_pnl_usd": { "type": "number" },
                "current_defense_layer": { "type": "integer" },
                "iterated_this_week": { "type": "boolean" },
                "iteration_detail": { "type": "string" },
                "cumulative_pct_from_open": { "type": "number" },
                "summary": { "type": "string" }
              }
            }
          }
        },
        "clean_sample_progress": {
          "type": "object",
          "properties": {
            "cumulative_clean_count": { "type": "integer", "minimum": 0, "maximum": 50 },
            "new_this_week": { "type": "integer", "minimum": 0 },
            "progress_pct": { "type": "number" },
            "violation_count_this_week": { "type": "integer" },
            "main_violation_types": { "type": "array", "items": { "type": "string" } }
          }
        },
        "summary": {
          "type": "object",
          "properties": {
            "core_iterations": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "core_insights": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          },
          "description": "用户输入。禁止 AI 生成"
        }
      }
    },
    "monthly_review": {
      "type": "object",
      "title": "MonthlyReview",
      "description": "月报（图谱十九节）",
      "required": ["type", "month_id", "capital_review", "position_status", "strategy_review", "all_review"],
      "properties": {
        "type": { "const": "monthly" },
        "month_id": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "capital_review": {
          "type": "object",
          "properties": {
            "principal_usd": { "type": "number", "const": 1200 },
            "current_okx_usd": { "type": "number" },
            "current_binance_usd": { "type": "number" },
            "total_current_usd": { "type": "number" },
            "net_loss_total_usd": { "type": "number" },
            "mom_change_usd": { "type": "number" },
            "mom_change_pct": { "type": "number" },
            "summary": { "type": "string" }
          }
        },
        "position_status": {
          "type": "object",
          "properties": {
            "main_account": { "type": "object" },
            "maker": { "type": "object" }
          }
        },
        "strategy_review": {
          "type": "object",
          "properties": {
            "maker": { "type": "object" },
            "main_account": { "type": "object" }
          }
        },
        "all_review": {
          "type": "object",
          "required": ["core_problems", "next_month_goals"],
          "properties": {
            "core_problems": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 3,
              "description": "整月核心问题复盘，至少 3 条"
            },
            "violations_summary": {
              "type": "object",
              "properties": {
                "total_count": { "type": "integer" },
                "level_severe": { "type": "integer" },
                "level_moderate": { "type": "integer" },
                "level_light": { "type": "integer" },
                "main_types": { "type": "array", "items": { "type": "string" } }
              }
            },
            "next_month_goals": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 3,
              "description": "具体可执行目标，禁止空话"
            }
          }
        }
      }
    }
  }
}
