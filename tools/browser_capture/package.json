{
  "name": "browser-capture",
  "version": "1.0.0",
  "private": true,
  "description": "日报六源独立浏览器自动化采集：BlockBeats、Coinglass、Exocharts、FedWatch、Farside、TradingView",
  "type": "module",
  "scripts": {
    "all": "node capture_all.js",
    "delta": "node capture_delta.js --slot midday",
    "delta:evening": "node capture_delta.js --slot evening",
    "cleanup": "node cleanup.js",
    "test:blockbeats-priority": "node test_blockbeats_priority.mjs",
    "blockbeats": "node capture_blockbeats.js",
    "coinglass": "node capture_coinglass.js",
    "exo": "node capture_exo.js",
    "fedwatch": "node capture_fedwatch.js",
    "farside": "node capture_farside_btc_etf.js",
    "tv": "node capture_tv.js"
  },
  "dependencies": {
    "playwright": "1.61.0"
  }
}
