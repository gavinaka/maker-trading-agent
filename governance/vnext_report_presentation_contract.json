  "maker_semantic_state_contract": {
    "schema_version": "maker-semantic-state-v1",
    "classification_owner": "deterministic_projection_of_certified_maker_decision",
    "candidate_submission_owner": "maker.risk_plan_nonempty",
    "exclusive_states": [
      "qualified_candidate",
      "rejected_submitted_candidate",
      "directional_thesis_only",
      "non_directional_observation"
    ],
    "qualified_candidate": {
      "direction": [
        "long",
        "short"
      ],
      "plan_state": "qualified",
      "plan_constructible": true,
      "candidate_submitted": true,
      "candidate_terms_allowed": true,
      "rejected_candidate_audit_required": false
    },
    "rejected_submitted_candidate": {
      "direction": [
        "long",
        "short"
      ],
      "plan_state": "observe",
      "plan_constructible": [
        true,
        false
      ],
      "candidate_submitted": true,
      "candidate_terms_allowed": "appendix_d_neutral_audit_only",
      "rejected_candidate_audit_required": true
    },
    "directional_thesis_only": {
      "direction": [
        "long",
        "short"
      ],
      "plan_state": "observe",
      "candidate_submitted": false,
      "candidate_or_rejected_candidate_label_allowed": false,
      "explicit_absence_disclosure_required": true,
      "rejected_candidate_audit_required": false
    },
    "non_directional_observation": {
      "direction": "observe",
      "plan_state": "observe",
      "primary_reason_code": "non_directional_thesis",
      "candidate_submitted": false,
      "candidate_or_rejected_candidate_label_allowed": false,
      "explicit_absence_disclosure_required": true,
      "rejected_candidate_audit_required": false
    },
    "state_terms_must_not_be_interchanged": true,
    "plan_numbers_require_candidate_submission": true
  },
  "fundamental_event_assessment_v1_projection": {
    "role": "observation_only_no_event_aligned_price_attribution",
    "load_bearing_allowed": false,
    "observation_only_reason_code": "event_price_attribution_unavailable",
    "forbidden_load_bearing_uses": [
      "winrate_adjustment",
      "account_current_basis",
      "account_trigger_logic"
    ],
    "price_attribution_basis_required_to_reenable": true,
    "secondary_signal": "fundamental_price_realization",
    "required_disposition": "no_adjustment",
    "required_no_adjustment_reason_code": "event_price_attribution_unavailable",
    "compiler_disclosure_required": true
  },
  "continuity_semantics": {
    "reconcile_filled": "prior_status_filled_ratio_exactly_100_percent_and_no_active_order_before_or_after",
