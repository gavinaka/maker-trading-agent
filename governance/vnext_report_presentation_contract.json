{
  "schema_version": "vnext-report-presentation-contract-v11",
  "purpose": "deterministic_human_readable_projection_of_certified_reasoning",
  "human_surface_source_of_truth": {
    "kind": "typed_canonical_projection",
    "inputs": [
      "observations",
      "claims",
      "decisions",
      "continuity"
    ],
    "report_sections_role": "forbidden_in_reasoning_model_v5",
    "free_text_second_truth_allowed": false,
    "typed_account_control_is_sole_load_bearing_source": true,
    "free_control_conclusion_or_invalidation_projection_allowed": false
  },
  "scenario_projection_contract": {
    "schema_version": "scenario-projection-v1",
    "ownership_schema_version": "scenario-ownership-v1",
    "producer_free_prose_projectable": false,
    "condition_owner_by_type": {
      "base": "bound_owner_claim.typed_state",
      "counter": "bound_owner_claim.trigger_logic",
      "invalidation": "bound_owner_claim.trigger_logic"
    },
    "transition_code_by_type": {
      "base": "retain_certified_assessment",
      "counter": "reassess_on_typed_counter",
      "invalidation": "invalidate_and_recollect_evidence"
    },
    "base_condition_by_account_direction": {
      "main": {
        "long": "主账户当前认证方向为偏多且绑定证据链有效",
        "short": "主账户当前认证方向为偏空且绑定证据链有效",
        "neutral": "主账户当前认证方向为中性且绑定证据链有效"
      },
      "maker": {
        "long": "Maker当前认证方向为偏多且绑定证据链有效",
        "short": "Maker当前认证方向为偏空且绑定证据链有效",
        "observe": "Maker当前认证方向为观察且绑定证据链有效"
      }
    },
    "projection_by_account_and_transition_code": {
      "main": {
        "retain_certified_assessment": {
          "expected_path": "主账户继续保留当前认证判断",
          "action": "主账户等待下一正式评分时点重新认证"
        },
        "reassess_on_typed_counter": {
          "expected_path": "主账户当前认证判断进入重新评估",
          "action": "主账户按触发后的类型化证据重新完成评估"
        },
        "invalidate_and_recollect_evidence": {
          "expected_path": "主账户当前认证判断失效",
          "action": "主账户重新采集证据并重建推理"
        }
      },
      "maker": {
        "retain_certified_assessment": {
          "expected_path": "Maker继续保留当前认证判断",
          "action": "Maker等待下一正式评分时点重新认证"
        },
        "reassess_on_typed_counter": {
          "expected_path": "Maker当前认证判断进入重新评估",
          "action": "Maker按触发后的类型化证据重新完成评估"
        },
        "invalidate_and_recollect_evidence": {
          "expected_path": "Maker当前认证判断失效",
          "action": "Maker重新采集证据并重建推理"
        }
      }
    },
    "canonical_audit_field_order": [
      "id",
      "account",
      "scenario_type",
      "owner_claim_id",
      "transition_code",
      "condition",
      "expected_path",
      "action"
    ],
    "execution_lifecycle_owner": "decision_and_continuity"
  },
  "human_visible_enum_domains": {
    "tradingview.chart_basis.volume_price_state": {
      "confirm": "确认",
